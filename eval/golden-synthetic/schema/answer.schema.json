{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aegisops/golden-synthetic/answer/v1",
  "title": "Ответ модели на кейс инцидента",
  "description": "Схема для structured outputs (response_format json_schema). Все поля обязательны; неиспользуемые параметры — null. Совместима со strict-режимом.",
  "type": "object",
  "additionalProperties": false,
  "required": ["incident_class", "root_cause", "action", "confidence", "evidence", "summary"],
  "properties": {
    "incident_class": {
      "type": "string",
      "enum": ["RB-001", "RB-002", "RB-003", "RB-004", "RB-005", "RB-006", "RB-007", "other"]
    },
    "root_cause": {
      "type": "string",
      "enum": [
        "pool_undersized", "client_tx_leak", "db_slow_queries", "db_connections_exhausted",
        "release_regression", "canary_insufficient_data", "downstream_db_degradation", "no_user_impact",
        "load_growth", "queue_backlog", "max_replicas_reached", "transient_spike",
        "crashloop_after_release", "crashloop_not_release", "memory_leak", "overcapacity", "unknown"
      ]
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "params"],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "rollout.abort_and_rollback", "workload.scale_out", "workload.scale_in", "workload.restart",
            "pgbouncer.resize_pool", "postgres.set_restart_param", "recommend", "none"
          ]
        },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": ["database", "new_pool_size", "new_min_replicas", "scope", "pod_name",
                       "reason", "analysis_run", "parameter", "value"],
          "properties": {
            "database": {"type": ["string", "null"]},
            "new_pool_size": {"type": ["integer", "null"]},
            "new_min_replicas": {"type": ["integer", "null"]},
            "scope": {"type": ["string", "null"], "enum": ["pod", "deployment", null]},
            "pod_name": {"type": ["string", "null"]},
            "reason": {"type": ["string", "null"],
                       "enum": ["canary_degradation", "bake_degradation", "insufficient_data_policy", null]},
            "analysis_run": {"type": ["string", "null"]},
            "parameter": {"type": ["string", "null"], "enum": ["max_connections", "shared_buffers", null]},
            "value": {"type": ["integer", "null"]}
          }
        }
      }
    },
    "confidence": {"type": "number"},
    "evidence": {"type": "array", "items": {"type": "string"}},
    "summary": {"type": "string"}
  }
}
